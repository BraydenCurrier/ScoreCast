[Unit]
Description=GameLine Pro LED Sports Ticker
# Keep ports 80 and 8080 on the home network. Do not forward them from the router.
After=NetworkManager.service
Wants=NetworkManager.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root

WorkingDirectory=/opt/scorecast/current

ExecStart=/opt/scorecast/current-venv/bin/python /opt/scorecast/current/src/main.py

Restart=always
RestartSec=3

StateDirectory=scorecast
StateDirectoryMode=0700
ReadWritePaths=/var/lib/scorecast

Environment=SCORECAST_CONFIG_DIR=/var/lib/scorecast
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
